NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/flowforge

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d

# CORS — comma-separated list of allowed frontend origins (Vite increments the
# port if 5173 is already taken, so a small range is listed by default)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Reliability (Phase 5) — retry/recovery poll scheduler interval, in milliseconds
RECOVERY_POLL_INTERVAL_MS=5000
